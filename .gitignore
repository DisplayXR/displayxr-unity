# Native build artifacts
native~/build/
native~/build-*/
native~/cmake-build-*/

# Dev-only files are hidden from Unity via `~` folders (Scripts~/, docs~/,
# native~/, Samples~/), so they need no .meta and never reach a consuming
# project's asset pipeline. Package-root files that DO ship (README/CHANGELOG/
# LICENSE/package.json/NOTICE/CONTRIBUTING) keep committed .meta files so
# consumers don't warn about meta-less assets in the immutable package folder.

# OS files
.DS_Store
Thumbs.db

# Runtime logs
displayxr.log
displayxr.log.meta
displayxr-app.log
displayxr-app.log.meta

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code runtime scratch
.claude/scheduled_tasks.lock
.claude/plans/

# Built plugin binaries (committed by CI, not manually)
# Uncomment these if you want CI to commit binaries:
# Runtime/Plugins/Windows/x64/*.dll
# Runtime/Plugins/macOS/*.dylib
# Runtime/Plugins/macOS/*.bundle
