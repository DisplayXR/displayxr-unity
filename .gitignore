# Native build artifacts
native~/build/
native~/build-*/
native~/cmake-build-*/

# Unity meta files for non-package directories
docs/**/*.meta
docs/*.meta
/docs.meta
/*.md.meta
# Root-level non-asset files Unity auto-generates metas for (NOTICE, release
# scripts) — the files are tracked, the incidental metas are not (see /*.md.meta).
/NOTICE.meta
/Scripts.meta
/Scripts/*.meta

# OS files
.DS_Store
Thumbs.db

# Runtime logs
displayxr.log
displayxr.log.meta
displayxr-app.log
displayxr-app.log.meta

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code runtime scratch
.claude/scheduled_tasks.lock
.claude/plans/

# Built plugin binaries (committed by CI, not manually)
# Uncomment these if you want CI to commit binaries:
# Runtime/Plugins/Windows/x64/*.dll
# Runtime/Plugins/macOS/*.dylib
# Runtime/Plugins/macOS/*.bundle
