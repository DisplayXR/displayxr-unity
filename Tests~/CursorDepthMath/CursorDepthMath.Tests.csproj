<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for Runtime/DisplayXRCursorDepthMath.cs (pure C#, no UnityEngine).
       Lives under Tests~ so Unity never imports it. Run: dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Runtime/DisplayXRCursorDepthMath.cs" Link="DisplayXRCursorDepthMath.cs" />
  </ItemGroup>
</Project>
