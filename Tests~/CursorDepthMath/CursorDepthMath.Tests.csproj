<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for Runtime/DisplayXRCursorDepthMath.cs (pure C#, no UnityEngine).
       Lives under Tests~ so Unity never imports it. Run: dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- The package targets Unity 2022.3 (C# 9): newer syntax must not pass here. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Runtime/DisplayXRCursorDepthMath.cs" Link="DisplayXRCursorDepthMath.cs" />
    <!-- Auto-convergence statistic / caps / follower (#461): AutoConvergenceTests.cs -->
    <Compile Include="../../Runtime/DisplayXRAutoConvergenceMath.cs" Link="DisplayXRAutoConvergenceMath.cs" />
  </ItemGroup>
</Project>
