<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for Runtime/Provider/DisplayXRGameViewCalibration.cs (pure C#, no UnityEngine): the
       position-coded marker of the editor Game-view calibration (#459) and the decoding of 1-px screen
       strips into the image's origin and its 1:1 verdict. Synthetic screens only: what a real screen
       shows is checked at the panel. Lives under Tests~ so Unity never imports it.
       Run: dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Runtime/Provider/DisplayXRGameViewCalibration.cs" Link="DisplayXRGameViewCalibration.cs" />
    <!-- The calibrator itself (when to show which marker, the reads, the reuse of measured layouts),
         compiled as shipped against Stubs.cs: a simulated clock, log, native plug-in and screen. -->
    <Compile Include="../../Runtime/Provider/DisplayXRGameViewCalibrator.cs" Link="DisplayXRGameViewCalibrator.cs" />
    <Compile Include="../../Runtime/Provider/DisplayXRGameViewPlacement.cs" Link="DisplayXRGameViewPlacement.cs" />
  </ItemGroup>
</Project>
