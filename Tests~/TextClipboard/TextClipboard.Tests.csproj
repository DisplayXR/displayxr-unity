<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for Runtime/DisplayXRTextClipboardRules.cs (pure C#, no UnityEngine): when the
       DisplayXR input fields take copy / cut / paste away from the base field, which keys those are,
       and what a copy puts on the clipboard. Lives under Tests~ so Unity never imports it.
       Run: dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Runtime/DisplayXRTextClipboardRules.cs" Link="DisplayXRTextClipboardRules.cs" />
  </ItemGroup>
</Project>
