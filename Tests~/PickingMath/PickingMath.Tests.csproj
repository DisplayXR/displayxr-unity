<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for Runtime/DisplayXRPickingMath.cs (pure C#, no UnityEngine): the screen
       point <-> ray / world point math behind DisplayXRPicking (#460). The off-axis test
       frusta come from DisplayXRCursorDepthMath.ProjectionFromFov (the provider's own
       builder). Lives under Tests~ so Unity never imports it. Run: dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Runtime/DisplayXRPickingMath.cs" Link="DisplayXRPickingMath.cs" />
    <Compile Include="../../Runtime/DisplayXRCursorDepthMath.cs" Link="DisplayXRCursorDepthMath.cs" />
  </ItemGroup>
</Project>
