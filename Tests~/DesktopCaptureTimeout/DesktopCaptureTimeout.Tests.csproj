<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for Runtime/DisplayXRDesktopCaptureTimeout.cs (pure C#, no UnityEngine):
       how long a blocking desktop capture waits, on the main thread and off it.
       Lives under Tests~ so Unity never imports it. Run: dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Runtime/DisplayXRDesktopCaptureTimeout.cs" Link="DisplayXRDesktopCaptureTimeout.cs" />
  </ItemGroup>
</Project>
