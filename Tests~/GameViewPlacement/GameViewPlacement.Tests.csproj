<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for Runtime/Provider/DisplayXRGameViewPlacement.cs (pure C#, no UnityEngine): where the
       editor Game-view glue anchors the weave for a docked / maximized / letterboxed view (#420), pinned
       to the numbers measured on a 300 % DS1 and checked against Unity's own placement rule at other
       scales. Lives under Tests~ so Unity never imports it. Run: dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Runtime/Provider/DisplayXRGameViewPlacement.cs" Link="DisplayXRGameViewPlacement.cs" />
  </ItemGroup>
</Project>
